<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <queries>
        <package android:name="com.retroarch.aarch64" />
        <package android:name="com.retroarch" />
        <package android:name="com.retroarch.ra32" />
        <package android:name="com.iiSULauncher" />
        <!-- Chrome se prioriza solo para el flujo visible de autenticación de Internet Archive. -->
        <package android:name="com.android.chrome" />
        <!-- Visibilidad limitada a integraciones documentadas o verificadas en tiempo de ejecución. -->
        <package android:name="org.ppsspp.ppsspp" />
        <package android:name="me.magnum.melonds" />
        <package android:name="com.github.stenzek.duckstation" />
        <package android:name="org.dolphinemu.dolphinemu" />
        <package android:name="org.azahar_emu.azahar" />
        <package android:name="com.flycast.emulator" />
        <package android:name="org.devmiyax.yabasanshioro2.pro" />
        <package android:name="com.virtualapplications.play" />
        <intent>
            <action android:name="com.retroarch.QUERY_INSTALLED_CORES" />
        </intent>
        <intent>
            <action android:name="com.retroarch.INSTALLED_CORES_RESULT" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" />
        </intent>
    </queries>

    <application
        android:name=".OzApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Oz RetroRom"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.OzRetroRom">

        <service
            android:name=".launch.RomDownloadJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".launch.RomDownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".launch.CollectionDownloadJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".catalog.background.CatalogPreparationJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".catalog.background.CatalogPreparationForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".catalog.background.CatalogPreparationActionReceiver"
            android:exported="false" />

        <service
            android:name=".launch.CollectionDownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".launch.RomDownloadActionReceiver"
            android:exported="false" />

        <activity
            android:name=".ui.EmulatorSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.LibrarySettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CatalogDownloadSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.EmulationIntegrationSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.InternetArchiveLoginActivity"
            android:exported="false" />

        <!--
          Debe continuar exportada para que iiSU pueda usar el comando explícito:
          cl.gakuto.kizuna/cl.gakuto.kizuna.launch.SessionActivity -a cl.gakuto.kizuna.action.PLAY -e ROM "%ROM%"

          No se publican filtros BROWSABLE, file://, HTTP ni HTTPS. El código valida
          cada gameId, URI y ruta antes de leerla.
        -->
        <activity
            android:name=".launch.SessionActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.OzRetroRom">
            <intent-filter>
                <action android:name="cl.gakuto.kizuna.action.PLAY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.GlobalCatalogActivity"
            android:exported="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
