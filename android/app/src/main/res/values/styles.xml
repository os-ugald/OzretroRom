<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="OzSectionTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/oz_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="OzBodyText" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/oz_text_secondary</item>
    </style>

    <style name="ShapeAppearance.Oz.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="ShapeAppearance.Oz.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.Oz.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ThemeOverlay.OzRetroRom.PopupMenu" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:textColor">@color/oz_text_primary</item>
    </style>

    <style name="Widget.Oz.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/arcade_purple</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Oz.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/oz_surface_raised</item>
        <item name="strokeColor">@color/arcade_purple</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/oz_text_primary</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>


    <!-- Oz Download Surface V3 - Oz Dark Night. Scoped to SessionActivity. -->
    <style name="Widget.Oz.DownloadButton.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_download_action_primary</item>
        <item name="android:textColor">#0B101D</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Oz.DownloadButton.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_download_action_secondary</item>
        <item name="android:textColor">@color/oz_download_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Oz.DownloadButton.Danger" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_download_action_danger</item>
        <item name="android:textColor">@color/oz_download_danger</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

</resources>
