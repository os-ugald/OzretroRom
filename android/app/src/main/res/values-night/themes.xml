<resources>
    <style name="Theme.OzRetroRom" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/arcade_purple</item>
        <item name="colorPrimaryVariant">@color/deep_purple</item>
        <item name="colorSecondary">@color/electric_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/oz_surface</item>
        <item name="colorOnSurface">@color/oz_text_primary</item>
        <item name="android:statusBarColor">@color/oz_background</item>
        <item name="android:navigationBarColor">@color/oz_surface</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/oz_background</item>
        <item name="android:colorBackground">@color/oz_background</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Oz.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Oz.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Oz.Large</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.OzRetroRom.Dialog</item>
    </style>

    <style name="ThemeOverlay.OzRetroRom.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Oz.Large</item>
    </style>

    <style name="Theme.OzRetroRom.Crt" parent="Theme.OzRetroRom">
        <item name="android:windowBackground">@color/oz_background</item>
    </style>
</resources>
