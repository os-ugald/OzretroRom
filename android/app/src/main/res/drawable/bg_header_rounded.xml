<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="@color/deep_purple" android:endColor="@color/oz_background" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="@color/arcade_purple" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="3dp">
        <shape>
            <solid android:color="@color/electric_blue" />
            <corners android:bottomLeftRadius="24dp" android:bottomRightRadius="24dp" />
        </shape>
    </item>
</layer-list>
