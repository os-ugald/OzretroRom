<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/oz_download_cyan"
                android:endColor="@color/oz_download_blue" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/oz_download_bg_deep" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/oz_download_panel" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/oz_download_outline" />
        </shape>
    </item>
</layer-list>
