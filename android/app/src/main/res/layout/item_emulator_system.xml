<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/oz_surface_raised"
    app:cardCornerRadius="14dp"
    app:strokeColor="@color/oz_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/systemNameText"
            style="@style/OzSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/recommendedEngineText"
            style="@style/OzBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp" />

        <Spinner
            android:id="@+id/engineModeSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/spinner_background"
            android:paddingHorizontal="12dp" />

        <Spinner
            android:id="@+id/externalAppSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/spinner_background"
            android:paddingHorizontal="12dp" />

        <TextView
            android:id="@+id/emulatorDetailsText"
            style="@style/OzBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp" />

        <TextView
            android:id="@+id/biosWarningText"
            style="@style/OzBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/testLaunchButton"
                style="@style/Widget.Oz.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Probar archivo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetEngineButton"
                style="@style/Widget.Oz.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Automático" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
