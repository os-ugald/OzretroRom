<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oz_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/OzSectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Motores y emuladores" />

    <TextView
        android:id="@+id/emulatorSummaryText"
        style="@style/OzBodyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Detectando aplicaciones compatibles…" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detectEmulatorsButton"
            style="@style/Widget.Oz.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Detectar instalados" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/restoreAllEnginesButton"
            style="@style/Widget.Oz.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Restaurar automático" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/emulatorSystemsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
