<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oz_background"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- A. Encabezado oficial -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_header_rounded"
        android:paddingHorizontal="8dp"
        app:contentInsetEnd="0dp"
        app:contentInsetStart="0dp"
        app:menu="@menu/menu_main"
        app:popupTheme="@style/ThemeOverlay.OzRetroRom.PopupMenu">

        <ImageView
            android:layout_width="238dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="Oz RetroRom"
            android:scaleType="fitCenter"
            android:src="@drawable/oz_wordmark_header" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- B y C. Búsqueda principal y acceso visible a filtros -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/oz_surface_raised"
        app:cardCornerRadius="24dp"
        app:strokeColor="@color/oz_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Buscar juegos, sagas o plataformas"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:startIconDrawable="@android:drawable/ic_menu_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filtersButton"
                style="@style/Widget.Oz.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Abrir filtros"
                android:text="Filtros" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- D. Acciones rápidas -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/globalCatalogButton"
                style="@style/Widget.Oz.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Catálogo global" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                style="@style/Widget.Oz.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:text="Configuración" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectFolderButton"
                style="@style/Widget.Oz.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:text="Puente iiSU" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/syncButton"
                style="@style/Widget.Oz.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:text="Sincronizar iiSU" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/randomGameButton"
                style="@style/Widget.Oz.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:text="Juego aleatorio" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- E. Colección y resumen compacto de filtros -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/oz_surface"
        app:cardCornerRadius="18dp"
        app:strokeColor="@color/oz_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <Spinner
                android:id="@+id/collectionSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_background"
                android:paddingHorizontal="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Filtros activos"
                    android:textColor="@color/oz_text_primary"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearFiltersButton"
                    style="@style/Widget.Oz.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Limpiar" />
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/activeFilterGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="4dp"
                app:singleLine="false" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textColor="@color/oz_text_primary"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/folderStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:textColor="@color/oz_text_secondary"
        android:textSize="12sp" />

    <!-- F. Lista paginada -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gameList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingBottom="16dp" />
</LinearLayout>
