cat << 'EOF' > .gitignore
# --- Node.js / Playwright / UI Audit ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.env
.env.local

# --- Python (python-hub) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/

# --- Android / Gradle (android) ---
*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build/
*/build/
/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex

# --- Sistema Operativo y Editores ---
Thumbs.db
.vscode/
*.swp
*.swo
EOF
